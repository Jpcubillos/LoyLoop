# Examples only. Set real values as environment variables; do not commit secrets.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_DEBUG=true
# Production defaults to HTTPS redirect and HSTS >= 31536000 seconds.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
# Enable only if every subdomain is HTTPS-ready; preload is a separate decision.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Set true only behind a trusted proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=false

# LL-235: only for explicit postgres profiles; do not copy a password into Git.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_POOL_MODE=session
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
DB_POOL_MAX_SIZE=5
DB_CONNECT_TIMEOUT=10

# Keep disabled until schema adoption and consumers are ready.
DJANGO_BUSINESS_API_ENABLED=false
SUPABASE_AUTH_URL=
SUPABASE_PUBLISHABLE_KEY=

# Private metrics access; generate a random value of at least 32 characters.
METRICS_BEARER_TOKEN=
